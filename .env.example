# Copy to .env for local development. Use your hosting provider's secret manager in production.
PORT=4000
APP_ORIGIN=http://localhost:5173
# In production change BOTH APP_ORIGIN and SITE_URL to your final HTTPS domain.
SITE_URL=http://localhost:5173
# First initialization only: choose a unique password of at least 12 characters.
# ADMIN_PASSWORD=use-a-long-random-admin-password

# PayPal: leave as sandbox until you have tested checkout.
PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# Email alerts: configure BOTH with Resend after verifying your sending domain.
# RESEND_API_KEY=re_...
# MAIL_FROM=Expert in Shopify <notifications@yourdomain.com>
# Then, in /admin > Email alerts, enter your receiving address.

# Public admin portfolio image uploads are re-encoded to WebP; no ClamAV required for those.
# Private client inbox uploads require ClamAV and are DISABLED by default.
ENABLE_CLIENT_UPLOADS=false
CLAMAV_SCAN=false
# To enable both: install clamscan, update its signatures, then set BOTH options true.
# Only JPG, PNG, WebP up to 2MB can be uploaded even with ClamAV enabled.

# Persistent paths REQUIRED for live environments (especially in Docker).
# DATA_DIR=/var/lib/expert-studio
# UPLOADS_DIR=/var/lib/expert-studio/uploads
# NODE_ENV=production
